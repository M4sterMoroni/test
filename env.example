# Prisma Cloud Configuration
# Copy this file to .env and fill in your actual values

# Prisma Cloud Console URL (required)
PRISMA_CLOUD_URL=https://your-prisma-cloud-instance.com

# Authentication - Username/Password (required)
PRISMA_CLOUD_USERNAME=your-username
PRISMA_CLOUD_PASSWORD=your-password

# Authentication - API Keys (optional, alternative to username/password)
PRISMA_CLOUD_ACCESS_KEY=your-access-key
PRISMA_CLOUD_SECRET_KEY=your-secret-key

# TwistCLI Configuration
TWISTCLI_PATH=./twistcli/twistcli.exe
OUTPUT_DIR=./scan-results

# Scan Configuration
SCAN_TERRAFORM=true
SCAN_DOCKER=true
SCAN_DOCKER_COMPOSE=true
POLICY_ENFORCEMENT=true

# Docker Configuration
DOCKER_IMAGE_NAME=test-app
DOCKER_IMAGE_TAG=latest

# Notification Configuration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
EMAIL_RECIPIENTS=security-team@company.com

# Logging Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
